generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())

  sessions  Session[]
}

model Session {
  id            String   @id @default(uuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  startTime     DateTime @default(now())
  endTime       DateTime?
  createdAt     DateTime @default(now())
  focusScore    Float    @default(0)
  burnoutScore  Float    @default(0)
  deepWorkScore Float    @default(0)
  entropyScore  Float    @default(0)
  switchCount   Int      @default(0)
  idleTime      Int      @default(0)
  totalDuration Int      @default(0)
  productivityScore Float @default(0)

  isDeepWork    Boolean  @default(false)

  activities    Activity[]

  @@index([userId])
  @@index([startTime])
}

model AppCategory {
  id        String   @id @default(uuid())
  appName   String   @unique
  category  String   // productive | neutral | distracting
  createdAt DateTime @default(now())
}


model Activity {
  id              String   @id @default(uuid())
  session         Session  @relation(fields: [sessionId], references: [id])
  sessionId       String

  appName         String
  windowTitle     String

  startTime       DateTime
  endTime         DateTime
  duration        Int
  type            String?

  category        String?
  intent          String?
  focusImpact     Float?
  energyImpact    Float?
  confidence      Float?

  iconUrl         String?
  domain          String?
  url             String?

  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id])

  @@index([sessionId])
  @@index([startTime])
  @@index([projectId])
}
model AppPattern {
  id          String   @id @default(uuid())
  appName     String
  titleRegex  String
  category    String
  intent      String?
  focusImpact Float?
  energyImpact Float?
  confidence  Float?
  createdAt   DateTime @default(now())

  @@index([appName])
}
model DeepWorkSession {
  id              String   @id @default(uuid())
  userId          String
  goal            String?
  plannedMinutes  Int
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  status          String   // active | completed | abandoned
  enforcement     String   // observe | warn | require_reason | block

  allowedApps     String[]
  allowedDomains  String[]
  blockedApps     String[]
  blockedDomains  String[]

  focusScore      Float    @default(0)
  violationCount  Int      @default(0)
  interruptionMs  Int      @default(0)
  productiveMs    Int      @default(0)
  distractionMs   Int      @default(0)
  idleMs          Int      @default(0)
  productivityScore Float @default(0)
  interventions   FocusIntervention[]
  minuteLogs      DeepWorkMinuteLog[]
  createdAt       DateTime @default(now())
  lastViolationAt DateTime?
}

model FocusIntervention {
  id              String   @id @default(uuid())

  deepWorkId      String

  deepWork        DeepWorkSession @relation(fields: [deepWorkId], references: [id])

  appName         String
  domain          String?
  windowTitle     String

  detectedAt      DateTime @default(now())

  action          String
  reason          String?
  durationMs      Int?
    @@index([deepWorkId])
  @@index([detectedAt])
}
model DeepWorkMinuteLog {
  id            String   @id @default(uuid())
  deepWorkId    String
  deepWork      DeepWorkSession @relation(fields: [deepWorkId], references: [id], onDelete: Cascade)
  
  minuteIndex   Int      // 0, 1, 2, 3... relative to session start
  timestamp     DateTime @default(now())
  
  // Metrics at this minute
  focusScore        Float @default(0)
  productivityScore Float @default(0)
  
  // Flags
  distractionFlag   Boolean @default(false)
  idleFlag          Boolean @default(false)
  
  // Context snapshot
  appName       String?
  windowTitle   String?
  category      String?
  intent        String?
  
  createdAt     DateTime @default(now())
  
    @@index([deepWorkId])
  @@index([minuteIndex])
  @@index([timestamp])
}

// ── Rize-like intent / project / calendar layer ──

model Project {
  id            String         @id @default(uuid())
  userId        String
  name          String
  icon          String?
  color         String         @default("#8b5cf6")
  weeklyHourGoal Float         @default(10)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())

  rules         ProjectRule[]
  time          ProjectTime[]
  goals         Goal[]
  events        CalendarEvent[]
  activities    Activity[]
}

model ProjectRule {
  id           String  @id @default(uuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id])
  appName      String?
  domain       String?
  titleKeyword String?
  matchType    String  @default("exact")

  @@unique([projectId, appName, domain, titleKeyword])
  @@index([appName])
  @@index([domain])
}

model CalendarEvent {
  id         String   @id @default(uuid())
  userId     String
  title      String
  description String?
  location   String?
  startAt    DateTime
  endAt      DateTime
  allDay     Boolean  @default(false)
  color      String?
  source     String   @default("manual")
  status     String   @default("confirmed")
  busy       Boolean  @default(true)
  recurrenceRule String?
  reminderMinutes Int?
  externalId String?
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  deepWorkId String?
  notes      String?

  @@index([userId])
  @@index([startAt, endAt])
  @@index([deepWorkId])
  @@index([status])
  @@index([externalId])
}

model ProjectTime {
  id        String  @id @default(uuid())
  userId    String
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  date      String
  minutes   Float   @default(0)

  @@unique([userId, projectId, date])
  @@index([date])
}

model Goal {
  id        String  @id @default(uuid())
  userId    String
  title     String
  description String?
  type      String  @default("focus_minutes")
  unit      String?
  target    Float
  period    String  @default("daily")
  startDate DateTime?
  endDate   DateTime?
  priority  String  @default("medium")
  progress  Float   @default(0)
  completedAt DateTime?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  active    Boolean @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([active, period])
}

model Rating {
  id         String   @id @default(uuid())
  userId     String
  timestamp  DateTime @default(now())
  rating     Int
  deepWorkId String?

  @@index([userId])
}
