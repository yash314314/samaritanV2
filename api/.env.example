# Copy to .env (start-samaritan.sh does this automatically on first run).
DATABASE_URL="postgresql://postgres:password@localhost:5432/acpe?schema=public"

# Interface and port for the API + WebSocket server. Keep loopback for local use:
# the API trusts the userId it is given and enforces no authentication.
HOST=127.0.0.1
PORT=4000

# Comma-separated browser origins allowed to call the API. Unset = any
# http(s)://localhost / 127.0.0.1 / [::1] origin.
# CORS_ORIGIN=http://localhost:4001

# Only used by the optional email/password login.
# JWT_SECRET=change-me
# REFRESH_SECRET=change-me
