# Copy to .env (start-samaritan.sh does this automatically on first run).

# ─── Database ──────────────────────────────────────────────────────────
# DATABASE_TARGET picks the database: "local" (default) or "global".
#   local  -> LOCAL_DATABASE_URL, falling back to DATABASE_URL
#   global -> GLOBAL_DATABASE_URL, a shared multi-user database
# Switching: change DATABASE_TARGET, run `npm run db:migrate`, restart the API.
DATABASE_TARGET=local
DATABASE_URL="postgresql://postgres:password@localhost:5432/acpe?schema=public"
# LOCAL_DATABASE_URL="postgresql://postgres:password@localhost:5432/acpe?schema=public"
# GLOBAL_DATABASE_URL="postgresql://USER:PASSWORD@db.example.com:5432/samaritan?schema=public&sslmode=require"

# ─── Server ────────────────────────────────────────────────────────────
# Interface and port for the API + WebSocket server. Keep loopback unless a
# reverse proxy (see nginx/) sits in front.
HOST=127.0.0.1
PORT=4000
# Behind a reverse proxy, set the number of proxy hops so rate limits see client IPs.
# TRUST_PROXY=1

# Browser origins allowed to read API responses (comma-separated).
# Unset = any http(s)://localhost / 127.0.0.1 / [::1] origin.
# CORS_ORIGIN=http://localhost:4001
# Origins allowed to use the refresh cookie. Defaults to CORS_ORIGIN, else the
# dashboard on port 4001.
# AUTH_ORIGINS=http://localhost:4001

# ─── Authentication ────────────────────────────────────────────────────
# Signing key for access tokens: 32+ random characters. Required when
# NODE_ENV=production or DATABASE_TARGET=global; start-samaritan.sh generates
# one locally. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
# DEVICE_TOKEN_TTL_DAYS=90
# Self-service sign-up. Default: off for the local database, on for the global one.
# ALLOW_REGISTRATION=false
# Secure (HTTPS-only) refresh cookie. Default: on when NODE_ENV=production.
# AUTH_COOKIE_SECURE=false
# Cookie path; only change it when a proxy serves the API under a prefix (e.g. /svc/api/auth).
# AUTH_COOKIE_PATH=/api/auth
# The desktop tracker on this machine enrolls with a key file the API writes
# (local database only). LOCAL_OWNER_USER_ID picks the account; default: first admin.
# LOCAL_DEVICE_ENROLLMENT=true
# DEVICE_ENROLLMENT_KEY_FILE=../.runtime/device-enrollment.key
# LOCAL_OWNER_USER_ID=

# ─── Outbound requests ─────────────────────────────────────────────────
# Calendar feed imports may not reach private networks when serving the global
# database or in production. Override with true/false.
# ALLOW_PRIVATE_FETCH=
