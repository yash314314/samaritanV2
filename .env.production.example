# Copy to .env next to docker-compose.prod.yml. Compose refuses to start while
# a required value is missing. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Required
POSTGRES_PASSWORD=          # URL-safe characters only: it is embedded in a connection string
JWT_SECRET=                 # 32+ random characters
PUBLIC_ORIGIN=https://samaritan.example.com   # the exact origin users open, no trailing slash

# Database switch. "global" (default here) serves many users from one database:
# the bundled postgres service, or a managed one via GLOBAL_DATABASE_URL.
# DATABASE_TARGET=global
# GLOBAL_DATABASE_URL=postgresql://USER:PASSWORD@db.example.com:5432/samaritan?schema=public&sslmode=require

# Optional
# POSTGRES_USER=postgres
# POSTGRES_DB=acpe
# ALLOW_REGISTRATION=false      # default for the global database: open
# AUTH_COOKIE_SECURE=false      # only for a plain-HTTP trial on http://localhost
# HTTP_PORT=80
